{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEP Downgrader",
  "version": "../package.json",
  "identifier": "com.itsanchorpoint.aepdowngrader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/installer-ui.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "AEP Downgrader",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Open After Effects files in older versions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 460
        },
        "appPosition": {
          "x": 154,
          "y": 236
        },
        "applicationFolderPosition": {
          "x": 506,
          "y": 236
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQjNDNUZEMERGNUExNUYKUldSZm9mVU4vY1d6bXZoZEZhU1FqSTdjVUtzSnhFQTd2WWhHUUtVeU54M0lNQVFyMlBqVjZFOGIK",
      "endpoints": [
        "https://github.com/itsAnchorpoint/AEP-Downgrader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
